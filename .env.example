# ========================================================
# HOTEL SUNNY POINT — PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# Public Site Canonical URL (Used for sitemaps, Open Graph, QR generation, canonical links)
NEXT_PUBLIC_SITE_URL=https://hotelsunnypoint.com

# Server Environment & Port
NODE_ENV=production
PORT=3000

# --------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION (Phase 4 Production)
# --------------------------------------------------------
# Project URL & Public Anonymous Key (safe to expose to browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (Keep SECRET; server-side migrations & admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Primary Restaurant Multi-Tenant Isolation ID
NEXT_PUBLIC_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
